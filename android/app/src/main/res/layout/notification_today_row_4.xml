<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_row_4"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/today_check_4"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/today_check_description"
        android:padding="10dp"
        android:src="@drawable/ic_today_check_empty"/>

    <TextView
        android:id="@+id/today_text_4"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:textColor="@color/today_text_primary"
        android:textSize="13sp"/>

</LinearLayout>
