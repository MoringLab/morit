<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_compact_row"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/today_compact_check"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/today_check_description"
        android:padding="10dp"
        android:src="@drawable/ic_today_check_empty"/>

    <TextView
        android:id="@+id/today_compact_text"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textColor="@color/today_text_primary"
        android:textSize="14sp"/>

    <ImageView
        android:id="@+id/today_compact_add"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/today_action_add"
        android:padding="11dp"
        android:src="@drawable/ic_today_add"/>

    <ImageView
        android:id="@+id/today_compact_list"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/today_action_list"
        android:padding="11dp"
        android:src="@drawable/ic_today_list"/>

</LinearLayout>
